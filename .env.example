# CORE API (host standup binds loopback; Compose forces 0.0.0.0)
# 8787 is mcp-flow. Do not point Roster at it.
# ROSTER_API_HOST=127.0.0.1
ROSTER_API_PORT=8790
ROSTER_API=http://127.0.0.1:8790
# Compose web UI port. docker-compose.yml sets ROSTER_PUBLIC_URL from this.
ROSTER_WEB_PORT=5175
# Vite dev UI port. Compose exposes this on the compose network and does not publish it on the host.
ROSTER_PUBLIC_URL=http://127.0.0.1:5175

# Headless bootstrap (docs/STANDUP.md). Leave unset for interactive /setup.
# ROSTER_BOOTSTRAP_TOKEN=
# ROSTER_OWNER_EMAIL=
# ROSTER_OWNER_PASSWORD=
# ROSTER_OWNER_PASSWORD_HASH=
# ROSTER_OWNER_NAME=
# ROSTER_OWNER_TEMPLATE=empty
# ROSTER_API_TOKEN=
# ROSTER_API_TOKEN_SCOPES=read,write
# ROSTER_API_TOKEN_NAME=bootstrap
# Job callbacks (docs/API.md#jobs). Allowlist entries: host or host:port, ASCII/punycode only.
# ROSTER_CALLBACK_ALLOWLIST=hooks.internal:8443
# ROSTER_CALLBACK_SECRET=
# ROSTER_HARNESS_AUTOSTART=auto
# ROSTER_PROVIDER_ID=
# ROSTER_PROVIDER_NAME=
# ROSTER_PROVIDER_NPM=
# ROSTER_PROVIDER_BASE_URL=
# ROSTER_PROVIDER_API_KEY_ENV=
# ROSTER_PROVIDER_MODELS=

# Persist state / workspaces / auth (Compose sets /data)
# ROSTER_DATA_DIR=.roster-flow
# ROSTER_OPENCODE_DIR=.opencode
# ROSTER_WORKSPACE=.roster-flow/workspace

# Production image serves the Vite build from CORE (Compose sets /app/dist)
# ROSTER_STATIC_DIR=dist

# Optional OpenCode harness
# OPENCODE_BIN=/usr/local/bin/opencode
# OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=14180
# OPENCODE_SYSTEM_PORT=14181
# The company serve always loads ROSTER_OPENCODE_DIR/opencode.json. Set this to
# load an extra config file first (the ROSTER_OPENCODE_DIR file still applies on top).
# OPENCODE_CONFIG=

# Preferred: env refs written into opencode.json (OpenChamber pattern)
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# FEATHERLESS_API_KEY=

# ROSTER_HTTP_PORT is unused. Set ROSTER_WEB_PORT and ROSTER_API_PORT above.

# Optional dedicated token for POST /mcp (otherwise CORE login bearer, or open when ROSTER_SKIP_ONBOARDING=1)
# ROSTER_MCP_TOKEN=
# MCP_FLOW_URL=http://127.0.0.1:8787
# MCP_FLOW_ADMIN_TOKEN=
# SKILL_FLOW_URL=http://127.0.0.1:8788
# SKILL_FLOW_BIN=skill-flow
# ROSTER_URL=http://127.0.0.1:8790
# OPENFLOW_URL=http://127.0.0.1:3000

# Slack transport (#ship ↔ Slack). Never written to state.json.
# SLACK_BOT_TOKEN=xoxb-
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=xapp-          # Socket Mode
# SLACK_CHANNEL_SHIP=C0123456789
# SLACK_ROOM_MAP=ship:C0123456789,incidents:C0ABCDEF
# ROSTER_SLACK_SKIP_VERIFY=1     # local curl / Playwright only
# ROSTER_SLACK_API=https://slack.com/api
# GitHub PR/issue cards in #ship (PAT or GitHub App installation token — never written to state.json)
# GITHUB_TOKEN=
# GH_TOKEN=
# ROSTER_GITHUB_API=https://api.github.com
