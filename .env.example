# CORE API (host standup binds loopback; Compose forces 0.0.0.0)
# ROSTER_API_HOST=127.0.0.1
ROSTER_API_PORT=8790
ROSTER_API=http://127.0.0.1:8790
# Browser URL printed at boot (Compose publishes the UI+API on 5173)
ROSTER_PUBLIC_URL=http://127.0.0.1:5173

# Persist state / workspaces / auth (Compose sets /data)
# ROSTER_DATA_DIR=.roster-flow
# ROSTER_OPENCODE_DIR=.opencode
# ROSTER_WORKSPACE=.roster-flow/workspace

# Production image serves the Vite build from CORE (Compose sets /app/dist)
# ROSTER_STATIC_DIR=dist

# Optional OpenCode harness
# OPENCODE_BIN=/usr/local/bin/opencode
# OPENCODE_HOSTNAME=127.0.0.1
OPENCODE_PORT=14180
# OPENCODE_SYSTEM_PORT=14181

# Preferred: env refs written into opencode.json (OpenChamber pattern)
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Compose publish port (used by docker-compose.yml interpolation)
# ROSTER_HTTP_PORT=5173
